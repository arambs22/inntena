# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml defaults — change if you run your own)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inntena
POSTGRES_USER=inntena
POSTGRES_PASSWORD=inntena
# Full connection string (used by the app; keep in sync with the vars above)
DATABASE_URL=postgresql://inntena:inntena@localhost:5432/inntena

# ---------------------------------------------------------------------------
# Etsy Open API v3 (OPTIONAL)
# The app runs fine without these — Etsy-based saturation features are
# simply disabled if they're missing.
# Get credentials at: https://www.etsy.com/developers
# ---------------------------------------------------------------------------
ETSY_API_KEY=
ETSY_API_SECRET=

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

CRON_SECRET=

# ---------------------------------------------------------------------------
# Email (SendGrid) — OPTIONAL. Without both SENDGRID_API_KEY and
# SENDGRID_FROM_EMAIL, verification/reset links are logged to the console
# instead of emailed — useful for local dev. Sent over SendGrid's HTTPS API
# (not SMTP), so it works even on hosts that block outbound SMTP ports.
# SENDGRID_FROM_EMAIL must be verified as a Single Sender in the SendGrid
# dashboard (Settings > Sender Authentication) — no domain required.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
APP_URL=http://localhost:5173